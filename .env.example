# 실제 키를 적은 .env 파일은 절대 커밋하지 않습니다 (.gitignore 에 포함).
# 수업과 동일하게 Amazon Bedrock 을 사용합니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# 선택: 기본값은 수업 고정값
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# 트레이스 (Day 7 Observability)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=techscout

# 선택: GitHub API 한도(시간당 60회 → 5000회). 서버 환경변수로만 읽습니다.
# GITHUB_TOKEN=
# 1 이면 data/cache 의 조회 결과 재사용 (평가 재현성), 0 이면 항상 새로 조회
TECHSCOUT_CACHE=1
